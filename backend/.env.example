APP_NAME=SIGULA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# Production memakai MySQL/MariaDB (VPS Magercoding).
# Untuk coba cepat di lokal, ganti DB_CONNECTION=sqlite lalu
# `touch database/database.sqlite` — selain itu semua sama.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sigula
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Frontend & CORS
# Origin frontend yang boleh mengakses API (pisahkan dengan koma).
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ---------------------------------------------------------------------------
# Seeder
# SIGULA_DEFAULT_PASSWORD : password awal 3 akun bawaan (WAJIB diganti di production)
# SIGULA_SEED_DEMO        : isi data transaksi demo ±6 bulan (set false di production)
# ---------------------------------------------------------------------------
SIGULA_DEFAULT_PASSWORD=password
SIGULA_SEED_DEMO=true

# ---------------------------------------------------------------------------
# Ringkasan AI (opsional — Laravel AI SDK)
# Dipakai endpoint GET /api/v1/keuangan/ringkasan-ai. Bila dikosongkan,
# endpoint-nya membalas 503 dengan pesan jelas; fitur lain tetap jalan.
# Kunci API: console.anthropic.com (Claude) atau aistudio.google.com (Gemini)
# ---------------------------------------------------------------------------
# Pilih salah satu provider, lalu isi kunci API-nya saja.
# Ganti provider TIDAK perlu mengubah kode — cukup AI_PROVIDER + kuncinya.
AI_PROVIDER=anthropic

# Opsi A — Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Opsi B — Google Gemini: set AI_PROVIDER=gemini lalu isi baris di bawah
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@nirasarimurni.com"
MAIL_FROM_NAME="${APP_NAME}"
